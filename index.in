<!doctype html><html lang="ru"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SKERRY 0.29</title><style>
*{box-sizing:border-box}body{margin:0;background:#15242d;color:#fff;font:14px system-ui,sans-serif}canvas,iframe{position:fixed;inset:0;width:100%;height:100%;border:0}canvas{touch-action:none}iframe{top:49px;height:calc(100% - 49px)}header,footer,aside{position:fixed;z-index:2}header{top:0;left:0;right:0;display:flex;align-items:center;gap:12px;padding:14px 3vw;background:linear-gradient(#10212acc,transparent)}strong{letter-spacing:.15em}strong i{color:#ff9257}button,select{background:#162832e8;color:#fff;border:1px solid #ffffff48;border-radius:5px;font:inherit;padding:8px;cursor:pointer}button:focus-visible,select:focus-visible{outline:2px solid #ffa366}#meter{margin-left:auto;font:12px monospace;text-shadow:0 1px 3px #000}footer{inset:auto 0 0;padding:36px 3vw 14px;background:linear-gradient(transparent,#101d27e6);pointer-events:none}footer div,footer button,footer select{pointer-events:auto}h1{font:500 clamp(24px,4vw,45px) Georgia;margin:0}p{margin:3px 0 8px}aside{right:3vw;top:62px;max-width:75vw;background:#142c37ed;padding:8px}aside:empty{display:none}.controls{display:flex;flex-wrap:wrap;gap:5px}.pad{display:none}.touch{touch-action:none;user-select:none}@media(pointer:coarse){.pad{display:inline-flex;gap:4px}}@media(max-width:700px){header{gap:5px;padding:9px 2vw}button,select{padding:6px;font-size:12px}#meter{font-size:10px}footer{padding:25px 2vw 8px;font-size:12px}}
#work{position:fixed;top:60px;left:3vw;background:#152932ec;border:1px solid #ffffff42;padding:9px;max-width:90vw;border-radius:6px}#work:not([hidden]){display:flex;align-items:center;gap:5px;flex-wrap:wrap}#work input{width:52px;background:#23424d;color:white;border:0;padding:4px}#work label{font-size:11px}@media(max-height:480px){#work{top:40px;max-width:75vw}}
</style><canvas id="view"></canvas><iframe id="inlet" hidden title="Северный пролив"></iframe><header><strong><i>◩</i> SKERRY</strong><select id="mode" aria-label="Сцена"><option value="race">Автодром</option><option value="walk">От первого лица</option><option value="earth">Земля</option><option value="inlet">Северный пролив</option><option value="stress">Тест геометрии</option><option value="asset">Мастерская</option></select><span id="meter"></span></header><span hidden id="reticle" style="position:fixed;left:50%;top:50%;width:5px;height:5px;border-radius:50%;background:white;box-shadow:0 0 2px #111;pointer-events:none"></span><aside id="msg" role="status">Загрузка…</aside><footer id="panel"><h1 id="title">SK-27</h1><p id="info"></p><div class="controls"><select hidden id="fleet" aria-label="Число болидов"><option>16</option><option>128</option><option>256</option><option>512</option></select><button id="action">Автопилот</button><button id="pulse" hidden>Импульс</button><button id="cam">Камера</button><button id="warp" hidden>Время ×1</button><button id="near">Ближе</button><button id="far">Дальше</button><button id="sun">Свет</button><button id="audio" aria-pressed="false">Звук выкл.</button><select id="quality" aria-label="Качество"><option value="auto">Авто</option><option value="low">Эконом</option><option value="mid">Баланс</option><option value="high">Детально</option><option value="4k">4K экран</option></select><button id="shot">Фото 6K</button><button hidden id="route">Горный маршрут</button><button hidden id="airCam">Вид из кабины</button><button hidden id="dem">Рельеф ASC</button><button id="import">Импорт glTF</button><button id="save">Сохранить вид</button><button id="load">Открыть вид</button><span class="pad"><button class="touch" data-key="ArrowLeft">◀</button><button class="touch" data-key="ArrowUp">Газ</button><button class="touch" data-key="ArrowDown">Тормоз</button><button class="touch" data-key="ArrowRight">▶</button></span></div></footer>
<section id="work" hidden><select id="active" aria-label="Объект"></select><label>X <input type="number" id="edx" step="0.25" value="0"></label><label>Y <input type="number" id="edy" step="0.25" value="0"></label><label>Z <input type="number" id="edz" step="0.25" value="0"></label><label>Угол, ° <input type="number" id="edrot" step="5" value="0"></label><label>Масштаб <input type="number" id="edsize" step="0.1" value="0"></label><button id="dupe">Копия / добавить</button><button id="remove">Удалить объект</button><button id="writeProject">Скачать сцену</button><button id="readProject">Открыть сцену</button></section><input hidden type="file" id="projectFile" accept=".json"><input hidden type="file" id="demFile" accept=".asc,.txt"><input hidden id="files" type="file" multiple><script>/*DATA*/
/*CODE*/</script></html>
